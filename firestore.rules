rules_version = '2';

// Paste into Firebase Console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Profile: one document per user, keyed by their uid.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Recipes: each document carries the owner's uid.
    match /recipes/{recipeId} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    // Weekly plans: document id is "{uid}_{weekStart}", so ownership is checked
    // from the id. That also lets a user read a week that doesn't exist yet.
    match /plans/{planId} {
      allow read, delete: if signedIn() && planId.matches(request.auth.uid + '_.*');
      allow create, update: if signedIn()
        && planId == request.auth.uid + '_' + request.resource.data.weekStart
        && request.resource.data.uid == request.auth.uid;
    }
  }
}
